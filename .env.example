# ── Required in production ─────────────────────────────────────────────
# Canonical site URL, no trailing slash. Drives canonicals, sitemap, OG, schema
# and the public email address (info@<domain>).
NEXT_PUBLIC_SITE_URL=https://www.example.ae

# ── Quote form (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Everpine Website <quotes@example.ae>"
QUOTE_FROM_EMAIL=
# Private inbox that receives enquiries. Never rendered on the site.
QUOTE_TO_EMAIL=

# ── Optional ───────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXX). When set, a consent banner
# appears and GA loads only after the visitor accepts.
NEXT_PUBLIC_GA_ID=
# Non-Vercel hosting only: set to true on the one production host that should be indexed.
# (On Vercel, indexing follows VERCEL_ENV automatically; previews are always noindex.)
SITE_INDEXABLE=
# Google Search Console HTML-tag verification token (content value only)
GOOGLE_SITE_VERIFICATION=
